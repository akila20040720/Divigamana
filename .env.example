APP_ENV=production
APP_URL=https://divigamana.lk
DEMO_OTP_ENABLED=false
SKIP_DATABASE_CHECK=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=


QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_FALLBACK_BASE_URL=
QWEN_MODEL=qwen-plus
QWEN_MOCK_MODE=false

# Enable the provider only after credentials and IP allow-listing are confirmed.
IDEAMART_LIVE=false
# This second switch permits real money movement. Keep false during preflight.
IDEAMART_CAAS_LIVE=false
IDEAMART_APP_ID=
IDEAMART_PASSWORD=
IDEAMART_OTP_REQUEST_URL=https://api.ideamart.io/subscription/otp/request
IDEAMART_OTP_VERIFY_URL=https://api.ideamart.io/subscription/otp/verify
IDEAMART_SUBSCRIPTION_SEND_URL=https://api.ideamart.io/subscription/send
IDEAMART_SUBSCRIPTION_STATUS_URL=https://api.ideamart.io/subscription/getStatus
IDEAMART_SUBSCRIPTION_QUERY_BASE_URL=https://api.ideamart.io/subscription/query-base
IDEAMART_CAAS_DEBIT_URL=https://api.ideamart.io/caas/direct/debit
IDEAMART_CAAS_BALANCE_URL=https://api.ideamart.io/caas/balance/query
# Optional: only if this payment account/instrument was assigned in IdeaMart provisioning.
IDEAMART_CAAS_ACCOUNT_ID=
IDEAMART_CAAS_PAYMENT_INSTRUMENT=MobileAccount

# Use only the endpoints issued for the approved Mobitel application.
MSPACE_LIVE=false
MSPACE_CAAS_LIVE=false
MSPACE_APP_ID=
MSPACE_PASSWORD=
MSPACE_CAAS_DEBIT_URL=
MSPACE_CAAS_OTP_VERIFY_URL=
